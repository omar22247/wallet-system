# انسخ الملف ده لـ .env وغيّر كل القيم
# cp .env.example .env

# ---------- Images
REGISTRY=ghcr.io/your-github-username
IMAGE_TAG=latest

# ---------- Gateway
GATEWAY_PORT=8080

# ---------- Postgres
POSTGRES_ADMIN_USER=wallet_admin
POSTGRES_ADMIN_PASSWORD=change_me
AUTH_DB_PASSWORD=change_me
WALLET_DB_PASSWORD=change_me
NOTIFICATION_DB_PASSWORD=change_me
AUDIT_OWNER_PASSWORD=change_me
AUDIT_APP_PASSWORD=change_me

# ---------- RabbitMQ
RABBITMQ_USER=wallet
RABBITMQ_PASSWORD=change_me

# ---------- Redis
REDIS_PASSWORD=change_me

